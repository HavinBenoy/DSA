   "source": [
    "N = int(input(\"Enter the input number: \\n\"))\n",
    "\n",
    "for i in range(N):\n",
    "    for j in range(i+1):\n",
    "        print(\" * \", end=\"\")\n",
    "    print(\"\\n\")\n"
